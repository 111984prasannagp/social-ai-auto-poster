# Local AI Social Auto Poster
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Telegram token belongs in n8n Credentials. Never commit real secrets.

# n8n must receive the real OmniRoute key through a local credential/header setting. Never commit the real key.
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_MODEL=auto/best-vision
