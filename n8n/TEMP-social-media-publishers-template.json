{
  "name": "Social Media Publishers - Instagram Threads X Reddit",
  "nodes": [
    {
      "parameters": {
        "content": "SOCIAL MEDIA PUBLISHER TEMPLATE\n\nConnect your existing approved-post Code node -> Social Media Router.\nAll publisher nodes are DISABLED placeholders until API credentials and current endpoints are configured.\nInstagram + Threads need a publicly reachable image URL.\nX API is usage-priced in 2026.\nReddit requires valid OAuth/API access and subreddit rules must be followed."
      },
      "id": "fe45cf47-ef22-4644-acb7-5ee790f99bd7",
      "name": "SETUP NOTES - READ FIRST",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -360]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst j = item.json || {};\n\nreturn [\n  { json: { platform: \"instagram\", caption: [j.instagram?.caption || \"\", ...(j.instagram?.hashtags || [])].join(\" \").trim() }, binary: item.binary },\n  { json: { platform: \"threads\", caption: [j.threads?.text || \"\", ...(j.threads?.hashtags || [])].join(\" \").trim() }, binary: item.binary },\n  { json: { platform: \"x\", text: [j.x?.text || \"\", ...(j.x?.hashtags || [])].join(\" \").trim() }, binary: item.binary },\n  { json: { platform: \"reddit\", title: j.reddit?.title || \"\", body: [j.reddit?.body || \"\", ...(j.reddit?.hashtags || [])].join(\"\\n\\n\").trim() }, binary: item.binary }\n];"
      },
      "id": "d2d17832-925f-4f7a-92d6-5c30aa2075fa",
      "name": "Social Media Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2.2,
      "position": [0, 0],
      "notes": "Connect this to Prepare Approved Post. It creates one item per platform and keeps the original image binary.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "rules",
        "options": {"fallbackOutput": "extra"},
        "rules": {"values": [
          {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"leftValue": "={{ $json.platform }}", "rightValue": "instagram", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}},
          {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"leftValue": "={{ $json.platform }}", "rightValue": "threads", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}},
          {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"leftValue": "={{ $json.platform }}", "rightValue": "x", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}},
          {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"leftValue": "={{ $json.platform }}", "rightValue": "reddit", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}}
        ]}
      },
      "id": "4dc8dc6f-eb5b-45ba-8a39-0c9bc229399b",
      "name": "Route by Platform",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [260, 0],
