      "parameters": {"method": "POST", "url": "https://graph.facebook.com/v24.0/REPLACE_WITH_IG_USER_ID/media", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": {"parameters": [{"name": "image_url", "value": "https://REPLACE-WITH-PUBLIC-IMAGE-URL"}, {"name": "caption", "value": "={{ $json.caption }}"}, {"name": "access_token", "value": "REPLACE_WITH_META_ACCESS_TOKEN"}]}, "options": {"timeout": 60000}},
